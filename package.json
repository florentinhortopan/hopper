{
  "name": "attatta",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @attatta/orchestrator --filter @attatta/web dev",
    "dev:web": "pnpm --filter @attatta/web dev",
    "dev:api": "pnpm --filter @attatta/orchestrator dev",
    "build": "pnpm -r build",
    "seed": "pnpm --filter @attatta/orchestrator seed",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
