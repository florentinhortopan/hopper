# Comfy Platform API key (https://platform.comfy.org)
# Used as X-API-Key for Comfy Cloud; also extra_data for local partner nodes
COMFY_API_KEY=comfyui-your-key-here

# Prefer Comfy Cloud for free SD1.5 gen without a local GPU:
COMFY_BASE_URL=https://cloud.comfy.org
# Or local ComfyUI:
# COMFY_BASE_URL=http://127.0.0.1:8188

# auto | live | stub  (auto = live if reachable, else stub)
COMFY_MODE=auto

COMFY_WORKFLOWS_DIR=./comfy/workflows

# Free default for Comfy Cloud: sd15 (v1-5-pruned-emaonly-fp16)
COMFY_MODEL_PROFILE=sd15
# Optional fallback if a profile graph is missing
COMFY_MODEL_FALLBACK_PROFILE=sd15

# Wrap still plates to short MP4 for Remotion (hands always wraps when ffmpeg present)
# COMFY_WRAP_MP4=1

PORT=8787
PUBLIC_BASE=http://127.0.0.1:8787

NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# Simple shared password for the web UI (Vercel env / apps/web/.env.local).
# Leave empty to disable the login wall locally.
SITE_PASSWORD=

# --- Optional: library batch import ---
# Vision LLM for auto-categorize (OpenAI-compatible). Heuristics-only if unset.
# ATTATTA_LLM_API_KEY=
# ATTATTA_LLM_BASE_URL=https://api.openai.com/v1
# ATTATTA_LLM_VISION_MODEL=gpt-4o-mini

# DROPBOX_ACCESS_TOKEN=
# FRAMEIO_TOKEN=
# ATTATTA_IMPORT_URL_ALLOWLIST=cdn.example.com,files.example.com
